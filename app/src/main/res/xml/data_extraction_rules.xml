<?xml version="1.0" encoding="utf-8"?>
<!-- Back up the library (database, settings, saved pages) to the user's own Google backup; nothing goes anywhere else -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="articles/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="articles/" />
    </device-transfer>
</data-extraction-rules>
